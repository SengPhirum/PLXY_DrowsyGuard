.venv/
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/
models/*.pt
models/*.onnx
models/*.espdl
data/raw/*
data/processed/*
# Downloaded corpora live outside version control; import them into data/raw.
Driver Drowsiness Dataset (DDD)/
!data/raw/.gitkeep
!data/processed/.gitkeep
firmware/esp32s3/build/
firmware/esp32s3/sdkconfig
firmware/esp32s3/sdkconfig.old
# Fetched by `idf.py reconfigure`; sdkconfig.defaults and idf_component.yml are the
# tracked inputs. dependencies.lock is deliberately NOT ignored - it is the record of
# the exact component versions docs/DEPLOYMENT.md has to cite.
firmware/esp32s3/managed_components/
models/detectors/
# Docs-only build. `./plxy.sh docs-build` generates site/ from docs/ + mkdocs.yml;
# .venv-docs is the isolated mkdocs toolchain it installs on first use.
site/
.venv-docs/

# The slide deck is generated by scripts/presentation. The built .pptx under
# docs/assets/documents/ is tracked; its intermediate art and toolchain are not.
scripts/presentation/build/
scripts/presentation/node_modules/
scripts/presentation/package-lock.json
